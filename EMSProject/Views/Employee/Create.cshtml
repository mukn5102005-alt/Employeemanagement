@model EMSProject.Models.Employee
@{
    ViewData["Title"] = "Add Employee";
}

<div class="glass-panel" style="padding:28px; max-width:560px;">
    <h3 style="margin-bottom:20px;">Add New Employee</h3>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger" style="font-size:13px; margin-bottom:16px;"></div>

        <div class="form-field">
            <label>Full Name</label>
            <input asp-for="FullName" class="form-input" required />
        </div>

        <div class="form-field">
            <label>Email</label>
            <input asp-for="Email" type="email" class="form-input" required />
        </div>

        <div class="form-field">
            <label>Phone Number</label>
            <input asp-for="PhoneNumber" class="form-input" />
        </div>

        <div class="form-field">
            <label>Designation</label>
            <input asp-for="Designation" class="form-input" required />
        </div>

        <div class="form-field">
            <label>Salary (₹)</label>
            <input asp-for="Salary" type="number" step="0.01" class="form-input" required />
        </div>

        <div class="form-field">
            <label>Department</label>
            <select asp-for="DepartmentId" class="form-input" required>
                <option value="">-- Select Department --</option>
                @foreach (var dept in (List<EMSProject.Models.Department>)ViewBag.Departments)
                {
                    <option value="@dept.Id">@dept.Name</option>
                }
            </select>
        </div>

        <div class="form-field">
            <label>Date of Joining</label>
            <input asp-for="DateOfJoining" type="date" class="form-input" />
        </div>

        <button type="submit" class="btn-primary" style="margin-top:8px;">Save Employee</button>
        <a asp-action="Index" class="btn-ghost" style="margin-left:10px;">Cancel</a>
    </form>
</div>

<style>
    .form-field {
        margin-bottom: 16px;
    }

        .form-field label {
            display: block;
            font-size: 12px;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

    .form-input {
        width: 100%;
        padding: 10px 12px;
        background: rgba(255,255,255,0.03);
        border: 1px solid var(--glass-border);
        border-radius: 10px;
        color: var(--text);
        font-size: 14px;
    }

    select.form-input option {
        background: var(--bg-elevated);
        color: var(--text);
    }
</style>