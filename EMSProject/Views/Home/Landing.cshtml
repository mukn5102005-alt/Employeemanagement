@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>EMS &middot; Employee Management System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
            .landing {
                min-height: 100vh;
                position: relative;
                overflow: hidden;
                display: flex;
                flex-direction: column;
            }

            .landing-aurora {
                position: absolute;
                top: -200px;
                left: 50%;
                transform: translateX(-50%);
                width: 700px;
                height: 700px;
                border-radius: 50%;
                background: radial-gradient(circle, var(--accent-1) 0%, transparent 65%);
                opacity: 0.22;
                filter: blur(60px);
                animation: aurora-drift 14s ease-in-out infinite alternate;
                pointer-events: none;
            }

            .landing-nav {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 24px 48px;
                position: relative;
                z-index: 2;
            }

            .landing-brand {
                display: flex;
                align-items: center;
                gap: 10px;
                font-family: "Sora";
                font-weight: 600;
                font-size: 16px;
            }

            .landing-nav-actions {
                display: flex;
                gap: 10px;
            }

            .landing-hero {
                flex: 1;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                text-align: center;
                padding: 40px 24px;
                position: relative;
                z-index: 2;
            }

                .landing-hero h1 {
                    font-family: "Sora";
                    font-size: 44px;
                    font-weight: 700;
                    max-width: 680px;
                    line-height: 1.2;
                    margin-bottom: 16px;
                }

                    .landing-hero h1 span {
                        background: linear-gradient(135deg, var(--accent-1), var(--accent-2));
                        -webkit-background-clip: text;
                        -webkit-text-fill-color: transparent;
                        background-clip: text;
                    }

                .landing-hero p {
                    color: var(--text-muted);
                    max-width: 520px;
                    font-size: 15px;
                    margin-bottom: 28px;
                }

            .landing-hero-actions {
                display: flex;
                gap: 12px;
            }

                .landing-hero-actions .btn-primary, .landing-hero-actions .btn-ghost {
                    padding: 12px 24px;
                    font-size: 14px;
                }

            .feature-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
                gap: 20px;
                max-width: 920px;
                margin: 56px auto 60px;
                padding: 0 24px;
                position: relative;
                z-index: 2;
            }

            .feature-card {
                background: var(--glass);
                border: 1px solid var(--glass-border);
                border-radius: var(--radius);
                padding: 22px;
                backdrop-filter: blur(10px);
            }

                .feature-card .icon {
                    width: 38px;
                    height: 38px;
                    border-radius: 10px;
                    display: grid;
                    place-items: center;
                    margin-bottom: 14px;
                    background: linear-gradient(135deg, var(--accent-1), var(--accent-2));
                }

                .feature-card h4 {
                    font-size: 14px;
                    font-weight: 600;
                    margin-bottom: 6px;
                }

                .feature-card p {
                    font-size: 12.5px;
                    color: var(--text-muted);
                    line-height: 1.5;
                }

            .landing-footer {
                text-align: center;
                padding: 20px;
                color: var(--text-muted);
                font-size: 12px;
                position: relative;
                z-index: 2;
            }
    </style>
</head>
<body>
    <div class="landing">
        <div class="landing-aurora"></div>

        <nav class="landing-nav">
            <div class="landing-brand">
                <span class="brand-mark">EM</span>
                EMS Project
            </div>
            <div class="landing-nav-actions">
                <a asp-controller="Account" asp-action="Login" class="btn-ghost">Login</a>
                <a asp-controller="Account" asp-action="Register" class="btn-primary">Get Started</a>
            </div>
        </nav>

        <section class="landing-hero">
            <h1>Employee management, <span>reimagined</span></h1>
            <p>Ek hi platform mein employee records manage karo, live payroll aur headcount dashboard dekho, aur developers ke liye poori REST API bhi available hai.</p>
            <div class="landing-hero-actions">
                <a asp-controller="Account" asp-action="Register" class="btn-primary">Shuru karo &rarr;</a>
                <a href="/swagger" class="btn-ghost" target="_blank">API Docs dekho</a>
            </div>
        </section>

        <div class="feature-grid">
            <div class="feature-card">
                <div class="icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M16 11c1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3 1.34 3 3 3ZM8 11c1.66 0 3-1.34 3-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3Z" fill="#0B0E14" /></svg>
                </div>
                <h4>Employee Records</h4>
                <p>Full CRUD, role-based access (Admin/HR/Employee), aur server-side validation ke saath.</p>
            </div>
            <div class="feature-card">
                <div class="icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 13h6V4H4v9Zm0 7h6v-5H4v5Zm10 0h6V11h-6v9Zm0-16v5h6V4h-6Z" fill="#0B0E14" /></svg>
                </div>
                <h4>Live Dashboard</h4>
                <p>Headcount, department breakdown, aur payroll totals real LINQ aggregation se calculate hote hain.</p>
            </div>
            <div class="feature-card">
                <div class="icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="#0B0E14" stroke-width="2" /><path d="m20 20-3.5-3.5" stroke="#0B0E14" stroke-width="2" stroke-linecap="round" /></svg>
                </div>
                <h4>REST API</h4>
                <p>Swagger-documented endpoints, DTO-based contracts, external apps ke liye ready.</p>
            </div>
        </div>

        <footer class="landing-footer">
            Employee Management System &middot; Built with ASP.NET Core 10
        </footer>
    </div>
</body>
</html>