@* Views/Shared/_Layout.cshtml *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · EMS</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell">

        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="aurora"></div>
            <div class="brand">
                <span class="brand-mark">EM</span>
                <span class="brand-name">EMS Project</span>
            </div>

            <nav class="nav-group">
                <p class="nav-label">Workspace</p>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Employee" ? "active" : "")"
                   asp-controller="Employee" asp-action="Index">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none"><path d="M16 11c1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3 1.34 3 3 3ZM8 11c1.66 0 3-1.34 3-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3Zm0 2c-2.33 0-7 1.17-7 3.5V19h9v-2.5c0-.87.25-2.4 1.72-3.61A11.4 11.4 0 0 0 8 13Zm8 0c-.29 0-.62.02-.97.06 1.14.94 1.72 2.13 1.72 3.44V19h6v-2.5c0-2.33-4.67-3.5-6.75-3.5Z" fill="currentColor" /></svg>
                    Employees
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                   asp-controller="Dashboard" asp-action="Index">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none"><path d="M4 13h6V4H4v9Zm0 7h6v-5H4v5Zm10 0h6V11h-6v9Zm0-16v5h6V4h-6Z" fill="currentColor" /></svg>
                    Dashboard
                </a>
                <a class="nav-link" href="/swagger" target="_blank">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6" /><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                    API (Swagger)
                </a>
                <a class="nav-link" asp-controller="Home" asp-action="Index">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none"><path d="M3 21V7l9-4 9 4v14h-6v-6H9v6H3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                    Home
                </a>
            </nav>

            <div class="sidebar-foot">
                <div class="user-chip">
                    <div class="avatar">@(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "?")</div>
                    <div>
                        <p class="user-name">@User.Identity?.Name</p>
                        <p class="user-role">Member</p>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" style="margin-top:12px;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-ghost" style="width:100%;">Logout</button>
                </form>
            </div>
        </aside>

        <!-- Main -->
        <div class="main-col">
            <header class="topbar">
                <h1 class="page-title">@ViewData["Title"]</h1>
                <div class="topbar-actions">
                    <div class="search-box">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6" /><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                        <input type="text" placeholder="Search employees..." />
                    </div>
                </div>
            </header>

            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>